# ServiceOS — Remote Verification Harness secrets (NAMES ONLY — never commit real values)
#
# Copy this file to `.env.verify` (git-ignored) and fill in the values from the linked
# Supabase project. These are BACKEND, service-role secrets — they must NEVER be
# prefixed VITE_ and must NEVER appear in the frontend bundle or the public .env.example.
# Only the verification harness (scripts/verify/*) reads this file.

# Linked Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Service-role key (bypasses RLS). Required. Redacted from all harness output.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret used to invoke the deployed platform-worker (same as the worker's
# WORKER_SECRET). Required for the automation suite's job processing.
WORKER_SECRET=

# Optional: the project ref this harness is ALLOWED to touch. If set, the harness
# refuses to run unless SUPABASE_URL's project ref matches (safety allowlist). If
# unset, you must pass --confirm-project explicitly.
VERIFY_ALLOW_PROJECT_REF=

# Optional: explicit project ref (otherwise derived from SUPABASE_URL).
SUPABASE_PROJECT_REF=

# Optional: default tenant for controlled fixtures (defaults to the seeded Drummond
# tenant). Harness-only default; never used by product code.
VERIFY_TENANT=

# Optional: set to "true" to allow non-interactive CI runs.
VERIFY_CI=
