    {
      "name": "email_sync_runs",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "default": "gen_random_uuid()",
          "notNull": true
        },
        {
          "name": "tenant_id",
          "type": "uuid",
          "default": null,
          "notNull": true
        },
        {
          "name": "provider",
          "type": "text",
          "default": "'gmail'::text",
          "notNull": true
        },
        {
          "name": "sync_type",
          "type": "text",
          "default": null,
          "notNull": true
        },
        {
          "name": "status",
          "type": "text",
          "default": "'running'::text",
          "notNull": true
        },
        {
          "name": "started_at",
          "type": "timestamp with time zone",
          "default": "now()",
          "notNull": true
        },
        {
          "name": "completed_at",
          "type": "timestamp with time zone",
          "default": null,
          "notNull": false
        },
        {
          "name": "records_processed",
          "type": "integer",
          "default": "0",
          "notNull": true
        },
        {
          "name": "error_message",
          "type": "text",
          "default": null,
          "notNull": false
        },
        {
          "name": "metadata",
          "type": "jsonb",
          "default": "'{}'::jsonb",
          "notNull": true
        }
      ],
      "triggers": [
        {
          "name": "email_ingestion_run_guard_v2",
          "function": "CREATE OR REPLACE FUNCTION public.email_ingestion_run_guard_v2()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_catalog'\nAS $function$\ndeclare protected boolean;\nbegin\n  if tg_op='INSERT' then\n    if new.sync_type in ('messages','workspace_messages','workspace_backfill') then\n      if new.status<>'running' or new.completed_at is not null or new.records_processed<>0 or\n        jsonb_typeof(new.metadata->'email_account_id') is distinct from 'string' or\n        not coalesce(new.metadata->>'email_account_id'~*'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$',false) or new.metadata ? 'email_ingestion_v2' then\n        raise exception using errcode='42501',message='invalid_ingestion_attempt';\n      end if;\n    end if;\n    return new;\n  end if;\n  protected:=old.sync_type in ('messages','workspace_messages','workspace_backfill');\n  if tg_op='UPDATE' then protected:=protected or new.sync_type in ('messages','workspace_messages','workspace_backfill'); end if;\n  if not protected then if tg_op='DELETE' then return old; else return new; end if; end if;\n  if tg_op='DELETE' or current_user<>'email_ingestion_protocol_owner' then\n    raise exception using errcode='42501',message='email_attempt_requires_protocol';\n  end if;\n  if row(new.id,new.tenant_id,new.provider,new.sync_type,new.started_at,new.metadata->'email_account_id') is distinct from\n     row(old.id,old.tenant_id,old.provider,old.sync_type,old.started_at,old.metadata->'email_account_id') then\n    raise exception using errcode='42501',message='immutable_ingestion_attempt';\n  end if;\n  return new;\nend $function$\n",
          "definition": "CREATE TRIGGER email_ingestion_run_guard_v2 BEFORE INSERT OR DELETE OR UPDATE ON public.email_sync_runs FOR EACH ROW EXECUTE FUNCTION email_ingestion_run_guard_v2()"
        }
      ],
      "constraints": [
        "PRIMARY KEY (id)"
      ]
    },
