# ServiceOS — public frontend environment variables
#
# Copy this file to `.env.local` (git-ignored) and fill in the values.
# ONLY put PUBLIC, client-safe values here. Anything prefixed `VITE_` is
# injected into the browser bundle by Vite, so it MUST NOT contain secrets.
#
# Backend-only secrets (Supabase service-role key, Gmail/Slack/Simwood
# credentials, etc.) do NOT belong in this file. Those go in the server-side
# secret store (`.dev.vars` locally / the deploy platform's secrets) and are
# never prefixed `VITE_`.

# Supabase — public project URL and anon/publishable key (both safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Auth — public signup is OFF by default (access is invite-only). Set to "true"
# to show the self-service sign-up form on the login page. Public flag only.
VITE_ENABLE_SIGNUP=
