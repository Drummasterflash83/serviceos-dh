{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "OpenFolk Drummonds recording backup foundation. London only; private retained versions; no runner, credentials or source transfer.",
  "Metadata": {
    "IntendedRegion": "eu-west-2",
    "Activation": "Requires reviewed AWS account, scoped source-read mechanism and separate runner/restore identities. Policies are unattached.",
    "BudgetScope": "AWS account-wide $5 monthly actual-cost alert, not a cap; excludes Supabase charges."
  },
  "Parameters": {
    "ExpectedAccountId": {
      "Type": "String",
      "AllowedPattern": "^[0-9]{12}$",
      "Description": "Verified OpenFolk AWS account ID; never deploy to a guessed account."
    },
    "RecordingTenantId": {
      "Type": "String",
      "Default": "00000000-0000-0000-0000-000000000001",
      "AllowedValues": [
        "00000000-0000-0000-0000-000000000001"
      ]
    },
    "BudgetAlertEmail": {
      "Type": "String",
      "AllowedPattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
      "Description": "OpenFolk owner-approved billing alert recipient."
    }
  },
  "Rules": {
    "ExpectedAccountAndRegion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::AccountId"
              },
              {
                "Ref": "ExpectedAccountId"
              }
            ]
          },
          "AssertDescription": "This stack must run in the verified OpenFolk AWS account."
        },
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "eu-west-2"
            ]
          },
          "AssertDescription": "This backup is approved for London only."
        }
      ]
    }
  },
  "Resources": {
    "Recordings": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "openfolk-drummonds-recordings-${AWS::AccountId}-eu-west-2"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "ObjectLockEnabled": true,
        "ObjectLockConfiguration": {
          "ObjectLockEnabled": "Enabled",
          "Rule": {
            "DefaultRetention": {
              "Mode": "GOVERNANCE",
              "Days": 30
            }
          }
        },
        "Tags": [
          {
            "Key": "OpenFolkPurpose",
            "Value": "recording-backup"
          },
          {
            "Key": "TenantId",
            "Value": {
              "Ref": "RecordingTenantId"
            }
          }
        ]
      }
    },
    "RecordingPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Bucket": {
          "Ref": "Recordings"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "RequireTLS",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Recordings",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Recordings.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "RequireSSES3OnWrites",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${Recordings.Arn}/*"
              },
              "Condition": {
                "StringNotEquals": {
                  "s3:x-amz-server-side-encryption": "AES256"
                }
              }
            },
            {
              "Sid": "RequireCreateOnlyWrites",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${Recordings.Arn}/*"
              },
              "Condition": {
                "Null": {
                  "s3:if-none-match": "true"
                },
                "Bool": {
                  "s3:ObjectCreationOperation": "true"
                }
              }
            }
          ]
        }
      }
    },
    "BackupWriterPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "Description": "Unattached: backup writer can create/verify tenant objects, never delete or bypass retention.",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "s3:GetBucketLocation",
                "s3:GetBucketVersioning",
                "s3:GetEncryptionConfiguration",
                "s3:GetBucketObjectLockConfiguration",
                "s3:GetBucketPublicAccessBlock",
                "s3:GetBucketPolicy",
                "s3:GetBucketOwnershipControls"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "Recordings",
                  "Arn"
                ]
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "s3:ListBucket",
                "s3:ListBucketVersions"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "Recordings",
                  "Arn"
                ]
              },
              "Condition": {
                "StringLike": {
                  "s3:prefix": {
                    "Fn::Sub": "tenants/${RecordingTenantId}/*"
                  }
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion",
                "s3:GetObjectRetention",
                "s3:PutObject"
              ],
              "Resource": {
                "Fn::Sub": "${Recordings.Arn}/tenants/${RecordingTenantId}/*"
              }
            },
            {
              "Effect": "Deny",
              "Action": [
                "s3:Delete*",
                "s3:BypassGovernanceRetention",
                "s3:PutObjectRetention",
                "s3:PutObjectLegalHold",
                "s3:PutBucket*",
                "s3:PutEncryptionConfiguration",
                "s3:PutLifecycleConfiguration"
              ],
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Recordings",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Recordings.Arn}/*"
                }
              ]
            }
          ]
        }
      }
    },
    "BackupRestorePolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "Description": "Unattached: restore identity can only inspect and read retained Drummonds versions.",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "s3:GetBucketLocation",
                "s3:GetBucketVersioning",
                "s3:GetEncryptionConfiguration",
                "s3:GetBucketObjectLockConfiguration",
                "s3:GetBucketPublicAccessBlock",
                "s3:GetBucketPolicy",
                "s3:GetBucketOwnershipControls"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "Recordings",
                  "Arn"
                ]
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "s3:ListBucket",
                "s3:ListBucketVersions"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "Recordings",
                  "Arn"
                ]
              },
              "Condition": {
                "StringLike": {
                  "s3:prefix": {
                    "Fn::Sub": "tenants/${RecordingTenantId}/*"
                  }
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion",
                "s3:GetObjectRetention"
              ],
              "Resource": {
                "Fn::Sub": "${Recordings.Arn}/tenants/${RecordingTenantId}/*"
              }
            },
            {
              "Effect": "Deny",
              "Action": [
                "s3:Put*",
                "s3:Delete*",
                "s3:BypassGovernanceRetention",
                "s3:RestoreObject"
              ],
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Recordings",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Recordings.Arn}/*"
                }
              ]
            }
          ]
        }
      }
    },
    "MonthlyCostAlert": {
      "Type": "AWS::Budgets::Budget",
      "Properties": {
        "Budget": {
          "BudgetName": "openfolk-recording-backup-account-watch",
          "BudgetType": "COST",
          "TimeUnit": "MONTHLY",
          "BudgetLimit": {
            "Amount": 5,
            "Unit": "USD"
          },
          "CostTypes": {
            "IncludeCredit": false,
            "IncludeRefund": false
          }
        },
        "NotificationsWithSubscribers": [
          {
            "Notification": {
              "NotificationType": "ACTUAL",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 100,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "BudgetAlertEmail"
                }
              }
            ]
          }
        ]
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Value": {
        "Ref": "Recordings"
      }
    },
    "BucketArn": {
      "Value": {
        "Fn::GetAtt": [
          "Recordings",
          "Arn"
        ]
      }
    },
    "TenantPrefix": {
      "Value": {
        "Fn::Sub": "tenants/${RecordingTenantId}/"
      }
    },
    "WriterPolicyArn": {
      "Value": {
        "Ref": "BackupWriterPolicy"
      }
    },
    "RestorePolicyArn": {
      "Value": {
        "Ref": "BackupRestorePolicy"
      }
    },
    "Region": {
      "Value": {
        "Ref": "AWS::Region"
      }
    }
  }
}
