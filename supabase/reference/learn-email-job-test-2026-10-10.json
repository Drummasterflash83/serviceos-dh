        "name": "platform_jobs_active_job_key_uk",
        "definition": "CREATE UNIQUE INDEX platform_jobs_active_job_key_uk ON public.platform_jobs USING btree (tenant_id, job_key) WHERE ((job_key IS NOT NULL) AND (status = ANY (ARRAY['queued'::text, 'running'::text, 'retrying'::text])))"
